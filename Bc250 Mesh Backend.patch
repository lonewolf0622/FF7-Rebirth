+/* Return the graphics generation used for draw-time state that belongs to the
+ * currently bound mesh stage.  Ordinary graphics state must continue to use
+ * the physical GFX1013/GFX10 identity.
+ */
+ALWAYS_INLINE static enum amd_gfx_level
+radv_cmd_buffer_mesh_gfx_level(const struct radv_cmd_buffer *cmd_buffer)
+{
+   const struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+
+   return cmd_buffer->state.shaders[MESA_SHADER_MESH] && radv_bc250_mesh_enabled(pdev) ? GFX10_3
+                                                                                     : pdev->info.gfx_level;
+}
+
+ALWAYS_INLINE static bool
+radv_cmd_buffer_uses_bc250_mesh(const struct radv_cmd_buffer *cmd_buffer)
+{
+   return radv_cmd_buffer_mesh_gfx_level(cmd_buffer) == GFX10_3 &&
+          radv_device_physical(radv_cmd_buffer_device(cmd_buffer))->info.family == CHIP_GFX1013;
+}
