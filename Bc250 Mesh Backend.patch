+/* BC-250 (GFX1013) mesh compatibility policy. The physical device remains
+ * GFX10 globally; only true mesh shader stages use GFX10.3 compiler and
+ * graphics semantics. Task shaders remain unsupported because their native
+ * RADV path requires the disabled ACE/compute-only queue.
+ */
+#define RADV_BC250_MESH_BACKEND_VERSION 1u
+
+bool radv_bc250_mesh_enabled(const struct radv_physical_device *pdev);
+
+static inline enum amd_gfx_level
+radv_effective_shader_gfx_level(const struct radv_physical_device *pdev, mesa_shader_stage stage)
+{
+   return stage == MESA_SHADER_MESH && radv_bc250_mesh_enabled(pdev) ? GFX10_3 : pdev->info.gfx_level;
+}
+
+static inline const struct ac_compiler_info *
+radv_effective_shader_compiler_info(const struct radv_physical_device *pdev, mesa_shader_stage stage)
+{
+   return stage == MESA_SHADER_MESH && radv_bc250_mesh_enabled(pdev) ? &pdev->mesh_compiler_info
+                                                                    : &pdev->info.compiler_info;
+}
